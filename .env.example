# PostgreSQL / Neon connection used by the Worker runtime and Prisma.
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Generate with a password manager. Required in production for privacy-safe actor hashes.
RATE_LIMIT_SECRET="replace-with-at-least-32-random-bytes"

# Optional replaceable Geometry Dash metadata service. See README for its JSON contract.
GD_LEVEL_PROVIDER_URL=""

# Canonical public origin used in generated links and metadata where needed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
