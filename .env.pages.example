# Public Supabase project values. These are embedded in the browser build;
# database and storage security must be enforced with the included RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Use /repository-name/ for a GitHub project site, or / for username.github.io.
VITE_BASE_PATH=/macrohub/
