{
  "name": "macrohub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:pages": "vite --config vite.pages.config.ts",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "start": "vinext start",
    "postinstall": "prisma generate",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern out-pages --ignore-pattern .next --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit --incremental false",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@neondatabase/serverless": "1.1.0",
    "@prisma/adapter-neon": "6.19.0",
    "@prisma/client": "6.19.0",
    "@supabase/supabase-js": "^2.112.4",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prisma": "6.19.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
